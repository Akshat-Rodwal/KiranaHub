PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/kirana-store
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=15
RATE_LIMIT_MAX_REQUESTS=100

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
FROM_EMAIL=orders@kiranahub.local
FROM_NAME=KiranaHub Fresh

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Resend HTTP API Email Provider (Recommended for Render / Cloud deployments)
RESEND_API_KEY=re_your_resend_api_key_here

# Brevo (formerly Sendinblue) REST API v3 (Recommended for Render - Unrestricted recipient delivery)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=your-verified-brevo-sender@gmail.com
